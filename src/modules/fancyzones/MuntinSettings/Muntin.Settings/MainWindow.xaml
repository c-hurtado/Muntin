<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Muntin.Settings.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Muntin Settings">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar
            x:Name="FileBar"
            Grid.Row="0"
            Margin="12,8,12,0"
            IsClosable="False"
            IsOpen="False"
            Severity="Error" />
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            CompactModeThresholdWidth="560"
            DisplayModeChanged="Nav_DisplayModeChanged"
            ExpandedModeThresholdWidth="900"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="Auto"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Arrange" Tag="Arrange">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Stage" Tag="Stage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Dock" Tag="Dock">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE718;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Animations" Tag="Animations">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Spacing" Tag="Spacing">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9A6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Startup" Tag="Startup">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <ScrollViewer
                x:Name="Scroller"
                Padding="24,12,24,24"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled">
                <StackPanel x:Name="Host" MaxWidth="860" />
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
